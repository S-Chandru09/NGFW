# =============================================================================
# AI-Powered Next Generation Firewall - Backend Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# Command: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AI-NGFW Zero Trust Firewall
APP_VERSION=1.0.0
APP_DESCRIPTION=AI-Powered Next Generation Firewall with Zero Trust Architecture
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=true

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32
# Shared key for AI engine -> backend internal API calls
INTERNAL_API_KEY=dev-internal-api-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=ai_ngfw
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=10

# Docker MongoDB example:
# MONGODB_URL=mongodb://admin:adminpassword@mongodb:27017/ai_ngfw?authSource=admin

# -----------------------------------------------------------------------------
# Zero Trust
# -----------------------------------------------------------------------------
ZERO_TRUST_ENABLED=true
DEFAULT_DEVICE_TRUST_SCORE=50.0
MIN_TRUST_SCORE_FOR_ACCESS=60.0

# -----------------------------------------------------------------------------
# Machine Learning
# -----------------------------------------------------------------------------
ML_MODELS_PATH=../ml/models
SKLEARN_MODEL_FILENAME=sklearn/threat_classifier.pkl
TENSORFLOW_MODEL_PATH=tensorflow/threat_classifier
ML_INFERENCE_THRESHOLD=0.75

# -----------------------------------------------------------------------------
# Network Capture
# -----------------------------------------------------------------------------
NETWORK_CAPTURE_ENABLED=true
CAPTURE_INTERFACE=eth0
CAPTURE_BPF_FILTER=ip or ip6
PCAP_STORAGE_PATH=../network/pcap/incoming
PCAP_MAX_FILE_SIZE_MB=100

# -----------------------------------------------------------------------------
# AI Engine
# -----------------------------------------------------------------------------
AI_ENGINE_ENABLED=true
AI_ENGINE_URL=http://localhost:8001
AI_ENGINE_ANALYZE_ENDPOINT=/api/v1/analyze/pcap
AI_ENGINE_LIVE_ENDPOINT=/api/v1/analyze/live
AI_ENGINE_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
